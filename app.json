{
  "expo": {
    "name": "Stumart",
    "slug": "stumart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stumart-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/stumart-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.rokadu10.stumart"
    },
    "web": {
      "favicon": "./assets/stumart-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Stumart uses your photos so vendors can upload product and skill images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b8da7b71-ba69-4a2c-9134-e3848b5c85c8"
      }
    }
  }
}
